GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GRAFAPY_REFRESH_INTERVAL=15
# GRAFAPY_CAROUSEL_INTERVAL=6
# GRAFAPY_REQUEST_TIMEOUT=10

# Recommended on constrained hardware (e.g. Raspberry Pi 2) - these are
# Textual's own env vars, not GrafaPy's, but .env is loaded early enough
# to set them before Textual reads them. See ARCHITECTURE.md.
# TEXTUAL_FPS=10
# TEXTUAL_ANIMATIONS=none
# TEXTUAL_SMOOTH_SCROLL=0
